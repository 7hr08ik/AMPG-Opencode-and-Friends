{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "lsp": true,
  "permission": {
    "todowrite": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow"
  },
  "instructions": [
    "AGENTS.md",
    "instructions/INSTRUCTIONS.md",
    "instructions/LAWS.md",
    "instructions/common/*.md"
  ],
  "plugins": [
    "opencode/plugins/*.ts",
    "billion-context",
    "opencode-tps-meter@latest",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-mem"
  ],
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "[local] Lemonade",
      "options": {
        "baseURL": "http://10.69.30.23:13305/v1"
      },
      "models": {
        "Ornith-1.5-35B-A3B-GGUF-Q8_0": {
          "name": "[Coding]_Ornith-1.5",
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 2048
            },
            "temperature": 0.6,
            "top_k": 20,
            "top_p": 0.95
          }
        },
        "Qwen3.6-35B-A3B-MTP-GGUF": {
          "name": "[Thinking]_Qwen3.6:35B-A3B",
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 2048,
            },
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0,
            "presence_penalty": 0,
            "repeat_penalty": 1
          },
          "variants": {
            "thinking": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 2048
                },
                "temperature": 0.6,
                "top_p": 0.95,
                "top_k": 20,
                "min_p": 0,
                "presence_penalty": 1,
                "repeat_penalty": 1
              }
            },
            "fast": {
              "reasoningEffort": "none",
              "textVerbosity": "low",
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 2048
                },
                "temperature": 1,
                "top_p": 0.95,
                "top_k": 20,
                "min_p": 0,
                "presence_penalty": 1.5,
                "repeat_penalty": 1
              }
            }
          }
        },
        "Qwopus3.5-9B-Coder-MTP": {
          "name": "[Multi]_Qwopus3.5:9B",
          "limit": {
            "context": 120000,
            "output": 16384
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 2048
            },
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0,
            "presence_penalty": 0,
            "repeat_penalty": 1
          },
          "variants": {
            "thinking": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 2048
                },
                "temperature": 0.6,
                "top_p": 0.95,
                "top_k": 20,
                "min_p": 0,
                "presence_penalty": 0,
                "repeat_penalty": 1
              }
            },
            "fast": {
              "reasoningEffort": "none",
              "textVerbosity": "low",
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 2048
                },
                "temperature": 1,
                "top_p": 0.95,
                "top_k": 20,
                "min_p": 0,
                "presence_penalty": 1.5,
                "repeat_penalty": 1
              }
            }
          }
        },
      }
    },
  },
  "compaction": {
    "auto": false,
    "prune": true,
    "reserved": 10000
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "drawio": {
      "type": "local",
      "command": [
        "npx",
        "@drawio/mcp"
      ],
      "enabled": true
    },
    "markitdown-mcp": {
      "type": "local",
      "enabled": true,
      "command": [
        "markitdown-mcp"
      ]
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "oauth": false
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  }
}
