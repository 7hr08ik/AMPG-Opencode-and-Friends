# Secrets used by OpenCode ({env:NAME} substitutions in opencode.jsonc).
# OpenCode does not parse this file itself; ~/.zshenv sources it into the
# environment so the background service inherits these values.

# Context7
CONTEXT7_API_KEY=<INPUT-CTX7-API>

# Opencode-Mem
STORAGE_PATH=~/.opencode-mem/data
## Provider type: "openai-chat" | "openai-responses" | "anthropic" | "minimax"
PROVIDER=openai-chat
MODEL=Ornith-1.5-35B-A3B-GGUF-Q8_0
APIURL=http://127.0.0.1:13305/v1
## Either the API from your provider, or "local" for locally hosted.
APIKEY=local