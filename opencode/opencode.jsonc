{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "lsp": true,
  "permission": {
    "todowrite": "allow",
    "lsp": "allow",
    "skill": "allow",
    "question": "allow"
  },
  "instructions": [
    "AGENTS.md",
    "instructions/INSTRUCTIONS.md",
    "instructions/LAWS.md",
    "instructions/common/*.md"
  ],
  "plugin": [
    "opencode-acp@stable",
    "opencode-ignore",
    "@mohak34/opencode-notifier@latest",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-mem"
  ],
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "[local] Lemonade",
      "options": {
        "baseURL": "http://127.0.0.1:13305/v1"
      },
      "models": {
        "Ornith-1.0-35B": {
          "name": "[Coding]_Ornith-1.0",
          "limit": {
            "context": 260000,
            "output": 32768
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
            "temperature": 0.6,
            "top_k": 20,
            "top_p": 0.95
          }
        },
        "Qwen3.6-35B-A3B": {
          "name": "[Thinking]_Qwen3.6:35B-A3B",
          "limit": {
            "context": 260000,
            "output": 32768
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0,
            "presence_penalty": 0,
            "repeat_penalty": 1
          },
          "variants": {
            "thinking": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 8192,
                },
                "temperature": 0.6,
                "top_p": 0.95,
                "top_k": 20,
                "min_p": 0,
                "presence_penalty": 1,
                "repeat_penalty": 1
              }
            },
            "fast": {
              "reasoningEffort": "none",
              "textVerbosity": "low",
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 8192,
                },
                "temperature": 1,
                "top_p": 0.95,
                "top_k": 20,
                "min_p": 0,
                "presence_penalty": 1.5,
                "repeat_penalty": 1
              }
            }
          }
        },
        "Qwopus3.5-9B-Coder-MTP": {
          "name": "[Multi]_Qwopus3.5:9B",
          "limit": {
            "context": 130000,
            "output": 16384
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0,
            "presence_penalty": 0,
            "repeat_penalty": 1
          },
          "variants": {
            "thinking": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 8192,
                },
                "temperature": 0.6,
                "top_p": 0.95,
                "top_k": 20,
                "min_p": 0,
                "presence_penalty": 0,
                "repeat_penalty": 1
              }
            },
            "fast": {
              "reasoningEffort": "none",
              "textVerbosity": "low",
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budgetTokens": 8192,
                },
                "temperature": 1,
                "top_p": 0.95,
                "top_k": 20,
                "min_p": 0,
                "presence_penalty": 1.5,
                "repeat_penalty": 1
              }
            }
          }
        },
        "Gemma-4-26B-A4B-it-MTP-GGUF": {
          "name": "[General]_Gemma4:26B-A4B",
          "limit": {
            "context": 130000,
            "output": 32768
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
            "temperature": 1,
            "top_p": 0.95,
            "top_k": 64
          }
        }
      }
    },
  },
  "compaction": {
    "auto": false,
    "prune": true,
    "reserved": 10000
  },
  "mcp": {
    "markitdown-mcp": {
      "type": "local",
      "enabled": true,
      "command": [
        "markitdown-mcp"
      ]
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "oauth": false
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-eedddcea-db1e-44ad-a119-293a20b174f5"
      }
    }
  }
}
